+/// Helper function to estimate query complexity for fast path optimization
+size_t QueryAnalyzer::countTableExpressions(const QueryTreeNodePtr & join_tree_node)
+{
+    if (!join_tree_node)
+        return 0;
+        
+    auto node_type = join_tree_node->getNodeType();
+    if (node_type == QueryTreeNodeType::TABLE || node_type == QueryTreeNodeType::TABLE_FUNCTION)
+        return 1;
+    if (node_type == QueryTreeNodeType::JOIN)
+        return countTableExpressions(join_tree_node->as<JoinNode>().getLeftTableExpression()) + 
+               countTableExpressions(join_tree_node->as<JoinNode>().getRightTableExpression());
+    return 1;  // For subqueries, array joins, etc.
+}
