+/// Fast path implementation for performance optimization
+QueryTreeNodePtr IdentifierResolver::tryResolveIdentifierFast(
+    const IdentifierLookup & identifier_lookup,
+    IdentifierResolveScope & scope)
+{
+    if (!use_fast_path || !enable_fast_path)
+        return nullptr;
+        
+    // Only use fast path for simple expression lookups
+    if (!identifier_lookup.isExpressionLookup())
+        return nullptr;
+        
+    // Try expression arguments first (most common case)
+    if (auto result = tryResolveFromExpressionArgumentsFast(identifier_lookup, scope))
+        return result;
+        
+    // Try join tree resolution
+    if (auto result = tryResolveFromJoinTreeFast(identifier_lookup, scope))
+        return result;
+        
+    return nullptr;
+}
+
+QueryTreeNodePtr IdentifierResolver::tryResolveFromExpressionArgumentsFast(
+    const IdentifierLookup & identifier_lookup, 
+    IdentifierResolveScope & scope)
+{
+    auto it = scope.expression_argument_name_to_node.find(identifier_lookup.identifier.getFullName());
+    if (it == scope.expression_argument_name_to_node.end())
+        return nullptr;
+        
+    // For simple cases, return directly without complex compound expression handling
+    if (identifier_lookup.identifier.isShort())
+        return it->second;
+        
+    return nullptr;  // Fall back to full resolution for compound identifiers
+}
+
+QueryTreeNodePtr IdentifierResolver::tryResolveFromJoinTreeFast(
+    const IdentifierLookup & identifier_lookup,
+    IdentifierResolveScope & scope)
+{
+    // For simple column references, try direct table expression lookup
+    if (!identifier_lookup.identifier.isShort())
+        return nullptr;
+        
+    // Check if we have exactly one table expression (simple case)
+    if (scope.table_expression_node_to_data.size() != 1)
+        return nullptr;  // Fall back to full resolution for complex joins
+        
+    auto & [table_expression, table_data] = *scope.table_expression_node_to_data.begin();
+    auto it = table_data.column_name_to_column_node.find(identifier_lookup.identifier.getFullName());
+    
+    return (it != table_data.column_name_to_column_node.end()) ? it->second : nullptr;
+}
